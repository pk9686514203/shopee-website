# Copy this file to .env and add your real keys.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
PEXELS_API_KEY=your_pexels_api_key_here

# Express API
PORT=4000
API_BASE=http://localhost:4000
CLIENT_ORIGIN=http://localhost:8080

# Frontend override when the API is not on the Vite proxy target.
# VITE_API_URL=http://localhost:4000

# Firebase client config
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# MongoDB is optional locally. Without this, the API stores history/wishlist
# in backend/data/*.json so uploads still work during development.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=outfit_recommendations
